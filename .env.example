# Public frontend configuration (a publishable/anon key, never service_role).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_STUN_URL=stun:stun.l.google.com:19302

# Server-only: set in Vercel, never prefix with VITE_. Optional; absent means STUN only.
METERED_DOMAIN=YOUR_APP.metered.live
METERED_SECRET_KEY=YOUR_SERVER_SECRET
